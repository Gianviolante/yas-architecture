# Sanity CMS Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_token

# ELVIS Security Dashboard
# Password for accessing /admin/elvis security dashboard (server-side validation only)
ELVIS_PASSWORD=your_secure_password
# Token for webhook authentication (generate with: openssl rand -hex 32)
ELVIS_WEBHOOK_TOKEN=your_webhook_token

# Email Notifications
# Primary recipient for ELVIS security alerts
ELVIS_NOTIFY_PRIMARY=studio@yas-arc.com
# Secondary recipient for ELVIS security alerts
ELVIS_NOTIFY_SECONDARY=secondary@example.com

# Email Service
# Resend API key for sending contact form emails and security alerts
RESEND_API_KEY=your_resend_api_key

# Application
# Base URL for the application (used in email links and webhooks)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
